{
  "name": "dsh-web-fetch-tavily",
  "version": "0.2.1",
  "description": "Tavily Extract as the web_fetch provider for the DSH web seam (ctx.web), with a custom endpoint.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tavily",
    "web-fetch"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huakira/dsh-web-fetch-tavily.git"
  }
}
